{
  "expo": {
    "name": "HPM",
    "slug": "hpm",
    "owner": "houston-public-media",
    "sdkVersion": "58",
    "version": "10.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "launchMode": "most-recent",
    "platforms": [ "ios", "android" ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "appleTeamId": "7CNNQ3255B",
      "supportsTablet": true,
      "bundleIdentifier": "com.jacapps.hpm",
      "buildNumber": "32",
      "version": "10.2.0",
      "deploymentTarget": "16.4",
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./HouPubMed.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch",
          "audio"
        ],
        "UIUserInterfaceStyle": "Light",
        "UIViewControllerBasedStatusBarAppearance": false,
        "LSMinimumSystemVersion": "16.4"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "bitcode": "Release",
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jacobsmedia.KUHFV3",
      "versionCode": "32",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2797448917961410~9781974870",
          "iosAppId": "ca-app-pub-2797448917961410~9781974870",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-vector-icons/fontawesome6",
      "@react-native-vector-icons/material-icons",
      "@react-native-vector-icons/ionicons",
      [
        "expo-build-properties", {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "buildToolsVersion": "37.0.0"
          },
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#ffffff",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "New Notification"
    },
    "extra": {
      "eas": {
        "projectId": "cf763f1a-eb2d-47d1-a581-bc42dc2e6b55"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cf763f1a-eb2d-47d1-a581-bc42dc2e6b55",
      "fallbackToCacheTimeout": 0,
      "runtimeVersion": "hpm-1",
      "enabled": false
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-2797448917961410~9781974870",
    "ios_app_id": "ca-app-pub-2797448917961410~9781974870"
  }
}
